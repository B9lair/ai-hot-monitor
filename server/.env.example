# ===== 服务端口 =====
PORT=4000

# ===== OpenRouter AI 服务 =====
OPENROUTER_API_KEY=
# 内容筛选/验证模型（高性价比 flash 模型，高频调用）
OPENROUTER_MODEL=deepseek-v4-flash
# 评估法官模型（仅离线跑评估脚本时调用，可用更强模型；留空则回退到 OPENROUTER_MODEL）
OPENROUTER_JUDGE_MODEL=
# 相关性判定阈值：AI 只输出 relevance 分数，服务端用该阈值判定「是否相关」（0~1）
RELEVANCE_THRESHOLD=0.6
# AI 校验前廉价预过滤：丢弃标题/摘要完全不含关键词任一有效 token 的条目（true/false）
PRE_FILTER_KEYWORD=true

# ===== 数据源 API Keys（可选，不填则跳过对应数据源） =====
# Twitter (X) 数据源：https://twitterapi.io/
TWITTER_API_KEY=

# ===== Twitter 质量过滤门槛（默认已按需求设定，可按需调整） =====
TWITTER_MIN_LIKES=30
TWITTER_MIN_RETWEETS=10
TWITTER_MIN_VIEWS=1000
TWITTER_MIN_FOLLOWERS=100
TWITTER_VERIFIED_BONUS=10

# ===== 微博搜索（可选，需登录 cookie；不填则跳过微博搜索） =====
# 从浏览器登录 weibo.com 后，复制请求头里的 Cookie 粘贴到这里
WEIBO_COOKIE=

# ===== 知乎搜索（可选，需登录 cookie；不填则跳过知乎） =====
# 从浏览器登录 zhihu.com 后，复制请求头里的 Cookie 粘贴到这里
ZHIHU_COOKIE=

# ===== GitHub 搜索（可选）：填写后接口限流由 10 次/分钟提升至 30 次/分钟 =====
# 生成地址：https://github.com/settings/tokens （公开仓库检索用默认权限即可）
GITHUB_TOKEN=

# ===== B站详情富化（补充播放/赞/投币/收藏/弹幕/评论/分享与发布时间） =====
# 是否对 B站搜索结果发起详情接口富化（true/false，关闭则退回仅播放量）
ENRICH_BILIBILI=true
# 每源详情富化条数上限（避免额外请求爆炸）
ENRICH_LIMIT=5
# B站 cookie（可选，提升详情接口稳定性）
BILI_SESSDATA=

# ===== 数据源开关（true/false） =====
# 国内可用源默认启用
SOURCE_TWITTER=true
SOURCE_HACKERNEWS=true
SOURCE_BILIBILI=true
SOURCE_WEIBO=true
SOURCE_BING=true
SOURCE_SOGOU=true
SOURCE_BAIDU=true
SOURCE_GITHUB=true
SOURCE_ZHIHU=true
# 境外源默认关闭（国内网络不可直连，挂代理/换网络后可手动开启）
SOURCE_GOOGLE=false
SOURCE_DUCKDUCKGO=false
SOURCE_REDDIT=false
SOURCE_V2EX=false

# ===== 分层过滤：第一层时间窗口（小时；仅过滤带发布时间的条目，无发布时间的放行） =====
# 默认窗口（未单独配置的源）
TIME_WINDOW_HOURS=168
# 按源差异化：快节奏源短、慢热源长
TIME_WINDOW_TWITTER=72
TIME_WINDOW_HACKERNEWS=720
TIME_WINDOW_GITHUB=720
TIME_WINDOW_REDDIT=720
TIME_WINDOW_V2EX=720
TIME_WINDOW_WEIBO=72
TIME_WINDOW_BILIBILI=720
TIME_WINDOW_ZHIHU=720

# ===== 采集/保留分离（避免"先截断后过滤"） =====
# 采集条数（每源）：采集阶段放宽
COLLECT_LIMIT=20
# 保留条数（每源）：第二层质量过滤后的输出上限，避免单一源淹没其他源
PER_SOURCE_LIMIT=8
# 第二层全局热度门槛（0~100，默认 0 = 关闭）：过滤「有热度分且低于门槛」的条目；搜索引擎无热度分不受影响
MIN_HOT_SCORE=0

# ===== 查询扩展（Query Expansion）=====
# 是否用 AI 为关键词生成同义/变体查询词以提高搜索召回（true/false）
QUERY_EXPAND=true
# 扩展词数量上限（1~5）
QUERY_EXPAND_LIMIT=3

# ===== 邮件发送（SMTP，登录验证 + 热点通知共用）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
# 注意：QQ/163 等必须填「SMTP 授权码」，不是登录密码
SMTP_PASS=your_smtp_auth_code
SMTP_FROM=your_email@example.com
# 发件人显示名
MAIL_FROM_NAME=AI热点监控
# 回退收件人（仅当【尚无任何用户登录】时使用；有用户后按用户邮箱发送）
NOTIFY_EMAIL_TO=

# ===== 邮箱免密登录（Magic Link）=====
# 会话签名密钥，务必改成随机长字符串
SESSION_SECRET=please-change-me-to-a-long-random-string
# 验证链接基地址：留空 = 自动按访问来源推断（本地 / 局域网 IP / 域名都不用手改）
APP_BASE_URL=
# 登录链接有效期（分钟）
LOGIN_TOKEN_TTL_MIN=10
# 同邮箱重发冷却（秒）
LOGIN_RESEND_COOLDOWN_SEC=60
# 单 IP 每小时最多申请次数（防滥发）
LOGIN_MAX_PER_IP_HOUR=10
# Cookie 是否仅在 HTTPS 传输（生产 HTTPS 置 true）
COOKIE_SECURE=false
# 会话有效期（天）
SESSION_MAX_AGE_DAYS=30

# ===== 邮件通知策略 =====
# 发送模式：instant（每条即发）| digest（每轮聚合，推荐）| daily（每日汇总）
EMAIL_MODE=digest
# 每日汇总发送时间（HH:mm，仅 daily 模式生效）
EMAIL_DAILY_AT=09:00
# 单封邮件最多条数（超出分批）
EMAIL_MAX_ITEMS=20
# 每用户每小时邮件上限
EMAIL_MAX_PER_HOUR=6
# 免打扰时段（如 23-8；留空=关闭）
EMAIL_QUIET_HOURS=
# 邮件阈值过滤（0 = 关闭）
EMAIL_MIN_RELEVANCE=0
EMAIL_MIN_HOT_SCORE=0

# ===== 前端地址（用于跨域） =====
# 留空 = 不限制来源（反射请求来源），本地/局域网/域名自适应；生产建议显式填写
CLIENT_ORIGIN=

# ===== 定时任务默认间隔（分钟） =====
MONITOR_INTERVAL_MIN=30

# ===== 信息生命周期：命中保留天数（超过且未收藏 → 前端隐藏，数据库保留） =====
ALERT_TTL_DAYS=7
