generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 关键词监控配置
model Keyword {
  id          String   @id @default(cuid())
  text        String   @unique
  enabled     Boolean  @default(true)
  intervalMin Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  alerts      Alert[]
}

// 关键词命中（经过 AI 防伪验证后 → 热点）
model Alert {
  id          String    @id @default(cuid())
  keywordId   String
  keyword     Keyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  title       String
  url         String    @unique
  source      String
  snippet     String?
  summary     String
  isFake      Boolean
  confidence  Float
  relevance        Float?   // AI 相关度分数 0~1
  hotScore         Float?   // 综合热度分（跨源归一化 0~100）
  metrics          String?  // 原始互动指标 JSON 字符串（likes/retweets/views/stars/points…）
  relevanceReason  String?  // AI 判断相关性的理由
  fakeReason       String?  // AI 判断疑似假冒/谣言的理由
  author           String?  // 作者 / UP 主名称
  publishedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([keywordId, createdAt])
}

// 通知记录
model Notification {
  id        String   @id @default(cuid())
  type      String // alert
  channel   String // email | browser
  title     String
  content   String
  url       String?
  status    String   @default("sent")
  createdAt DateTime @default(now())
}
