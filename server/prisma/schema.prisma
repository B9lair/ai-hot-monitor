generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 关键词监控配置
model Keyword {
  id          String   @id @default(cuid())
  text        String   @unique
  enabled     Boolean  @default(true)
  intervalMin Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  alerts      Alert[]
}

// 热点范围配置
model Topic {
  id          String   @id @default(cuid())
  text        String   @unique
  enabled     Boolean  @default(true)
  intervalMin Int      @default(15)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hotspots    Hotspot[]
}

// 关键词命中（经过 AI 防伪验证后）
model Alert {
  id          String    @id @default(cuid())
  keywordId   String
  keyword     Keyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  title       String
  url         String    @unique
  source      String
  snippet     String?
  summary     String
  isFake      Boolean
  confidence  Float
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([keywordId, createdAt])
}

// 热点内容（经过 AI 聚合后）
model Hotspot {
  id          String    @id @default(cuid())
  topicId     String
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title       String
  url         String    @default("")
  source      String
  snippet     String?
  summary     String
  category    String?
  hotness     Float?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([topicId, createdAt])
}

// 通知记录
model Notification {
  id        String   @id @default(cuid())
  type      String // alert | hotspot
  channel   String // email | browser
  title     String
  content   String
  url       String?
  status    String   @default("sent")
  createdAt DateTime @default(now())
}
